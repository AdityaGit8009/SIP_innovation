# Process environment overrides config/runtime.local.php (ignored local overrides).
# This reference file is NOT automatically loaded as dotenv.
# To configure a missing LOCAL JWT secret without printing it:
# php tools/setup-local.php
JWT_SECRET=
# Omit to auto-detect, empty or / for root, e.g. /SIP_innovation for a subdirectory.
SIP_BASE_PATH=
DB_HOST=localhost
DB_NAME=spiinnovation
DB_USER=
DB_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Softpro Innovations
MAIL_ADMIN_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Absolute directory OUTSIDE the document root, writable by the PHP worker.
# Omit to use an application-specific private temp directory.
# PRIVATE_INVOICE_DIR=/var/lib/sip/invoices
